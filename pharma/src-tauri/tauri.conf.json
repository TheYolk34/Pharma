{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "pharma",
  "version": "0.1.0",
  "identifier": "com.bmstu.pharma",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "pharma",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "http": {
      "enabled": true
    }
  }, 
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"]
  }
}
